{
  "name": "llama",
  "version": "1.0.0",
  "description": "Simple llama chat",
  "keywords": [
    "bun",
    "app",
    "llama",
    "sample"
  ],
  "license": "MIT",
  "author": "Andrius Pratusis",
  "type": "module",
  "main": "index.js",
  "trustedDependencies": [],
  "scripts": {
    "postinstall": "bun run patch_onnx.js",
    "patch": "bun run patch_onnx.js",
    "patch:check": "bun run patch_onnx.js --check",
    "start": "bun run patch_onnx.js && bun run index.js",
    "web": "bun run patch_onnx.js && bun run index.js --web",
    "dashboard": "bun run patch_onnx.js && bun run index.js --dashboard",
    "babyagi": "bun run babyagi.ts",
    "ask": "bun run src/one_shot.js",
    "test": "bun test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google/genai": "^2.15.0",
    "@mistralai/mistralai": "^2.7.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "@xenova/transformers": "^2.17.2",
    "chalk": "^4.1.2",
    "dotenv": "^17.4.2",
    "marked": "^15.0.0",
    "marked-terminal": "^7.3.0",
    "ollama": "^0.6.3",
    "onetime": "5.1.2",
    "openai": "^7.3.0",
    "ora": "^5.4.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "pino": "^10.3.1",
    "playwright": "^1.63.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "say": "^0.16.0",
    "string-width": "4.2.3",
    "wavefile": "^11.0.0"
  }
}
