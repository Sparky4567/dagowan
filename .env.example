# --- Dagowan / Ollama assistant: local overrides (copy to `.env`) ---
# OLLAMA_HOST=http://host.docker.internal:11434
# # When using the bundled compose `ollama` profile instead:
# # OLLAMA_HOST=http://ollama:11434
#
# # Optional cloud LLM keys (also settable inside the app via @set-api-key)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# CLAUDE_API_KEY=
# GROK_API_KEY=
# MISTRAL_API_KEY=
#
# # Optional bridges / features
# WHATSAPP_PHONE=
# TELEGRAM_TOKEN=
# WHATSAPP_ENABLED=0
# WEB_ENABLED=1
# # WhatsApp pairing UX: auto (default; numeric code on Termux, QR elsewhere)
# # | qr (always QR) | pairing (always numeric code) | off (no QR output).
# # Termux cannot scan a QR with its own camera, so auto/pairing prints the
# # 8-digit code from @whatsapp-pair / POST /pair instead of terminal QR art.
# WHATSAPP_QR_MODE=auto
#
# # WhatsApp @character-name callouts: groups reply only when a persona is
# # tagged; 1:1 DMs reply as the tagged persona, else as the active character.
# # Strip the @mention before the LLM call (1) and prefix multi-persona
# # replies with the character name (1). Set to 0/false to disable.
# WHATSAPP_MENTION_ONLY_GROUPS=1
# WHATSAPP_STRIP_MENTION=1
# WHATSAPP_MENTION_PREFIX=1
#
# # Telegram persona polling (on-demand): only the active persona polls on
# # boot; others wake via @character / @wake / @Name mentions and auto-sleep
# # after N idle minutes (active persona never sleeps). Configure in
# # app_settings.json: persona_polling_on_demand (default true),
# # persona_idle_timeout_minutes (default 15, 0 disables auto-sleep),
# # persona_polling_sweep_seconds (default 60).
#
# # Ports (must match compose `ports` mapping if changed)
# WHATSAPP_PORT=8765
# WHATSAPP_STATUS_PORT=8766
# VOICE_PORT=8767
# WEB_PORT=8767
# # OpenWebUI-style dashboard (`./starter.sh --dashboard` / `-dashboard`):
# # DASHBOARD_ENABLED=1 starts it without a flag; DASHBOARD_PORT sets the port.
# DASHBOARD_PORT=8768
#
# # Agentic browser (Playwright/Chromium): visible local window by default,
# # headless automatically on display-less machines. Force with 1/0.
# BROWSER_HEADLESS=auto
# BROWSER_ALLOWED_DOMAINS=youtube.com,youtu.be,google.com,giphy.com,spotify.com,wordpress.com,blogger.com,blogspot.com
# BROWSER_NAV_TIMEOUT_MS=30000
# BROWSER_IDLE_CLOSE_MS=300000 (auto-close the controlled window after 5 min idle; 0 disables)
#
# # Official-API-first playback (default for @youtube-play/@play and
# # @spotify-play/@spotify; Chromium is the fallback when keys are missing
# # or the API fails). Force engine with PLAY_SOURCE=auto|api|browser.
# YOUTUBE_API_KEY=
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# PLAY_SOURCE=auto
#
# # Official-API-first blog drafts (default for @blog/@wordpress/@blogger/@post;
# # Chromium editor automation is the fallback when tokens are missing or the
# # API fails). Force engine with BLOG_SOURCE=auto|api|browser.
# WORDPRESS_SITE_URL=https://mysite.com
# WORDPRESS_USERNAME=
# WORDPRESS_APP_PASSWORD=
# BLOGGER_BLOG_ID=
# BLOGGER_ACCESS_TOKEN=
# # Optional: Google OAuth client file for @blogger-auth (auto-detected
# # as client_secret_*.apps.googleusercontent.com.json in the project dir)
# BLOGGER_OAUTH_CLIENT_FILE=
# BLOG_SOURCE=auto
#
# # Semantic Scholar fact-checking (default papers engine for @fact-check;
# # anonymous access works, an API key raises rate limits via x-api-key).
# # Gemini (GEMINI_API_KEY) adds an AI verdict on top (--source auto|papers|gemini).
# SEMANTIC_SCHOLAR_API_KEY=
# FACTCHECK_MAX_RESULTS=3
# FACTCHECK_SOURCE=auto
# FACTCHECK_GEMINI_MODEL=gemini-2.5-flash
#
# # Google AI Mode search (@live-gemini, provider google-ai): Gemini API
# # google_search grounding when GEMINI_API_KEY is set, else best-effort
# # keyless Google scrape with DuckDuckGo fallback.
# # GEMINI_SEARCH_MODEL=gemini-2.5-flash
# # WEBSEARCH_PROVIDER=auto (auto|duckduckgo|brave|tavily|google-ai)
#
# # On-device tool calling via cactus-needle (https://github.com/cactus-compute/needle).
# # @needle / @needle-extract / @needle-embed run the 8-29 MB local model through
# # python3 + src/needle_bridge.py (pip install cactus-needle; weights download
# # once, then fully offline). Auto-routing is off by default; manual @needle
# # commands always work once the package is installed.
# NEEDLE_ENABLED=0
# NEEDLE_MIN_CONFIDENCE=0.7
# NEEDLE_MODEL_PATH=
# NEEDLE_PYTHON=python3
# NEEDLE_DAEMON_IDLE_MS=300000 (persistent on-device daemon idles out after 5 min, freeing ~150 MB)

# # OpenAI coding agent (@opencli): API-driven tool loop jailed to projects/.
# # Needs OPENAI_API_KEY. Telegram/WhatsApp senders must be listed in
# # OPENCLI_ALLOWED_CHATS (comma-separated chat IDs / JIDs) or the command is
# # refused; CLI and Web UI count as local and are allowed when enabled.
# OPENCLI_ENABLED=1
# OPENCLI_MODEL=gpt-4o-mini
# OPENCLI_MAX_ITERATIONS=12
# OPENCLI_ALLOWED_CHATS=

# # TV cast (@cast-scan / @cast <url>): no extra install needed (ffmpeg +
# # Chromium already covered above). Same LAN as the TV required; discovery
# # uses SSDP/mDNS multicast, relay serves on CAST_PORT (default 8901).
# # Pin a TV to skip discovery: @set-cast-device 192.168.0.3
# CAST_DEVICE_NAME=
# CAST_DEVICE_HOST=
# CAST_DEVICE_TYPE=auto
# CAST_PORT=8901
# CAST_TRANSCODE=auto
# CAST_MAX_HEIGHT=
